# Apify — get your token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_your_token_here
X_USERNAME=the_account_to_monitor       # without the @

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdef...  # from @BotFather on Telegram
TELEGRAM_CHAT_ID=your_chat_id           # from @userinfobot (negative number = group chat)

# Tuning
POLL_INTERVAL_SECONDS=900   # how often to check (seconds). 900 = every 15 min
                             # Free Apify tier (~$5/mo credit) supports ~300-500 runs/month
                             # 900s = ~2,880 runs/month → use paid tier ($49/mo) for this rate
                             # 3600s = ~720 runs/month → comfortable on free tier
MIN_CONFIDENCE=medium        # low | medium | high — skip alerts below this threshold
